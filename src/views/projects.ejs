
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p><a href="/new-project">Add a New Service Project</a></p>

    <p>Here are our next upcoming service projects:</p>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <p>
                    <%= new Date(project.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        timeZone: 'UTC'
                    }) %>:
                </p>

                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>

                (Organization:
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>)
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
